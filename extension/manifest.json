{
  "manifest_version": 3,
  "name": "LeetCode GitHub Uploader",
  "version": "1.0.0",
  "description": "Automatically syncs your accepted LeetCode solutions to a GitHub repository.",
  "permissions": [
    "storage",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["scripts/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
